# Neon pooled PostgreSQL URL (TLS enabled) used by the API and migrations.
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
# Optional Neon direct URL for LISTEN/NOTIFY cross-instance event fan-out.
NEON_DIRECT_DATABASE_URL=
# Optional independent AES-GCM key for attendee QR token encryption.
QR_TOKEN_ENCRYPTION_KEY=
# High-entropy app master secret; domain-separated keys are derived for local sessions and QR encryption.
SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional canonical origin and CORS settings.
APP_ORIGIN=
CORS_ORIGINS=
PORT=4100
