{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "admin": {
      "root": "apps/admin",
      "framework": "vite"
    },
    "scanner": {
      "root": "apps/scanner",
      "framework": "vite"
    },
    "api": {
      "root": "services/api",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/scanner/(.*)",
      "destination": {
        "service": "scanner"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "admin"
      }
    }
  ]
}
